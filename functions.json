    "docstring_or_comment": "",
    "body": "\nfunction isprime(n::Int)::Bool\n    if n <= 1\n        return false\n    elseif n <= 3\n        return true\n    elseif n % 2 == 0 || n % 3 == 0\n        return false\n    end\n    i = 5\n    while i * i <= n\n        if n % i == 0 || n % (i + 2) == 0\n            return false\n        end\n        i += 6\n    end\n    return true\nend\n\n\nadd(a::Int, b::Int) = a + b\n\n\nstruct TreeNode\n    val::Int\n    left::Union{TreeNode, Nothing}\n    right::Union{TreeNode, Nothing}\nend",
