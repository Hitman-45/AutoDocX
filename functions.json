    "return_type": "vector<vector<int>>",
    "class_name": null,
    "belongs_to_class": false,
    "docstring_or_comment": "",
    "body": "vector<vector<int>> transposeMatrix(const vector<vector<int>>& mat) {\n    int rows = mat.size();\n    int cols = mat[0].size();\n    vector<vector<int>> trans(cols, vector<int>(rows));\n\n    for (int i = 0; i < rows; ++i)\n        for (int j = 0; j < cols; ++j)\n            trans[j][i] = mat[i][j];\n    return trans;\n}\n",
