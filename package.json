{
  "name": "autodocx",
  "displayName": "AutoDocX",
  "description": "Generates the AST and gives the documentation of the repo",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
 "contributes": {
    "commands": [
      {
        "command": "autodocx.openWebsite",
        "title": "Run Command"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myWebsiteViewContainer",
          "title": "My Web",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "myWebsiteViewContainer": [
        {
          "id": "myWebsiteView",
          "name": "Run Command"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "autodocx.openWebsite",
          "when": "view == myWebsiteView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
