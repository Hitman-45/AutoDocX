            {
              "name": "docstring_or_comment: \"Merge existing and new data, avoiding duplicates based on a key field.\""
            },
            {
              "name": "body: \"def _merge_data(self, existing: list[dict] | None, new_data: list[dict], key_field: str) -> list[dict]:\\n        \\\"\\\"\\\"Merge existing and new data, avoiding duplicates based on a key field.\\\"\\\"\\\"\\n        if not existing:\\n            return new_data\\n\\n        # Create a set of existing keys for O(1) lookup\\n        existing_keys = {item[key_field] for item in existing}\\n\\n        # Only add items that don't exist yet\\n        merged = existing.copy()\\n        merged.extend([item for item in new_data if item[key_field] not in existing_keys])\\n        return merged\""
            },
            {
              "name": "access_specifier: \"public\""
            },
