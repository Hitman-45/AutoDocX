              "name": "docstring_or_comment: \"\""
            },
            {
              "name": "body: \"  search(val) {\\n    let cur = this.root;\\n    while (cur) {\\n      if (val === cur.val) return true;\\n      cur = val < cur.val ? cur.left : cur.right;\\n    }\\n    return false;\\n  }\""
