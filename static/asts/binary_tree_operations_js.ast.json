            {
              "name": "docstring_or_comment: \"\""
            },
            {
              "name": "body: \"  insert(val) {\\n    const node = new TreeNode(val);\\n    if (!this.root) {\\n      this.root = node;\\n      return this;\\n    }\\n    let cur = this.root;\\n    while (true) {\\n      if (val < cur.val) {\\n        if (!cur.left) {\\n          cur.left = node;\\n          break;\\n        }\\n        cur = cur.left;\\n      } else {\\n        if (!cur.right) {\\n          cur.right = node;\\n          break;\\n        }\\n        cur = cur.right;\\n      }\\n    }\\n    return this;\\n  }\""
            },
            {
              "name": "access_specifier: \"public\""
            },
