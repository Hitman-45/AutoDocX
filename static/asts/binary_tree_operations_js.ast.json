            },
            {
              "name": "body: \"  inorder() {\\n    const result = [];\\n    (function traverse(node) {\\n      if (!node) return;\\n      traverse(node.left);\\n      result.push(node.val);\\n      traverse(node.right);\\n    })(this.root);\\n    return result;\\n  }\""
