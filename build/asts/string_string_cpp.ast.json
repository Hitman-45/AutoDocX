              "name": "body: \"    void String::StrSet(const char *str)\\n    {\\n        length = std::strlen(str);\\n        if(length < ssoLength)\\n        {\\n            std::memcpy(data.ssoBuffer, str, length + 1);\\n            isDynamic = false;\\n            return;\\n        }\\n\\n        data.dynamicBuffer = new char[length + 1];\\n        std::memcpy(data.dynamicBuffer, str, length + 1);\\n        isDynamic = true;\\n    }\\n\""
